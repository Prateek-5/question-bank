      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 13,
      "fontFamily": 1,
      "text": "Indexes:\n  \u2022 PK on short_code           \u2014 every redirect uses this\n  \u2022 INDEX on user_id            \u2014 \"list my URLs\"\n  \u2022 PARTIAL INDEX on expires_at WHERE expires_at IS NOT NULL  \u2014 TTL sweep",
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 11,
      "containerId": "f63ee4f7cf5397ea",
      "originalText": "Indexes:\n  \u2022 PK on short_code           \u2014 every redirect uses this\n  \u2022 INDEX on user_id            \u2014 \"list my URLs\"\n  \u2022 PARTIAL INDEX on expires_at WHERE expires_at IS NOT NULL  \u2014 TTL sweep",
      "lineHeight": 1.25
    },
