      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 13,
      "fontFamily": 1,
      "text": "Access patterns (the only thing that matters):\n\nREAD:    SELECT long_url WHERE short_code = ?    ~30K/sec   <5ms p99\nWRITE:   INSERT INTO url_mappings (...)           ~40/sec    <50ms\nLIST:    SELECT WHERE user_id = ? LIMIT 50        rare        <200ms\nSWEEP:   DELETE WHERE expires_at < now()           periodic    bg",
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 11,
      "containerId": "85662acd4b2b2843",
      "originalText": "Access patterns (the only thing that matters):\n\nREAD:    SELECT long_url WHERE short_code = ?    ~30K/sec   <5ms p99\nWRITE:   INSERT INTO url_mappings (...)           ~40/sec    <50ms\nLIST:    SELECT WHERE user_id = ? LIMIT 50        rare        <200ms\nSWEEP:   DELETE WHERE expires_at < now()           periodic    bg",
      "lineHeight": 1.25
    },
    {
      "id": "f61d5a6eb31f8657",
      "type": "text",
