      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 13,
      "fontFamily": 1,
      "text": "The 100:1 read:write asymmetry IS the design constraint.\nEverything downstream (cache thickness, replica count, write-path complexity) derives from it.",
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "The 100:1 read:write asymmetry IS the design constraint.\nEverything downstream (cache thickness, replica count, write-path complexity) derives from it.",
      "lineHeight": 1.25
    }
