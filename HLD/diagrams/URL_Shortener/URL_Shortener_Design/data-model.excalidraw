      "fontSize": 14,
      "fontFamily": 1,
      "text": "url_mappings\n\nshort_code         char(7)      PRIMARY KEY      \u2190 7-char base62\nlong_url           varchar(2048)  NOT NULL\nuser_id            uuid           nullable        \u2190 FK \u2192 identity svc\ncreated_at         timestamptz    NOT NULL\nexpires_at         timestamptz    nullable        \u2190 NULL = no expiry\nis_custom_alias    bool           default false",
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 12,
      "containerId": "68948c60cce4966a",
      "originalText": "url_mappings\n\nshort_code         char(7)      PRIMARY KEY      \u2190 7-char base62\nlong_url           varchar(2048)  NOT NULL\nuser_id            uuid           nullable        \u2190 FK \u2192 identity svc\ncreated_at         timestamptz    NOT NULL\nexpires_at         timestamptz    nullable        \u2190 NULL = no expiry\nis_custom_alias    bool           default false",
      "lineHeight": 1.25
    },
