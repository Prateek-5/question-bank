      "fontSize": 15,
      "fontFamily": 1,
      "text": "One table. Two writes per second average. Thirty-thousand reads per second peak. Every architecture choice falls out of this asymmetry.",
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "One table. Two writes per second average. Thirty-thousand reads per second peak. Every architecture choice falls out of this asymmetry.",
      "lineHeight": 1.25
    },
