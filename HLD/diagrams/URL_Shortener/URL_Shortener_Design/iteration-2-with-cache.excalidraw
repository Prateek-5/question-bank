      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 13,
      "fontFamily": 1,
      "text": "\u26a0 Hot keys: one viral link can saturate one Redis shard.\n\u26a0 Cache stampede on cold start: all instances hit DB simultaneously.\n\u26a0 Single API instance still a bottleneck \u2192 need LB + replicas.\n\u26a0 No async write path \u2192 analytics blocks the redirect.",
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 11,
      "containerId": "a0b9102178c62354",
      "originalText": "\u26a0 Hot keys: one viral link can saturate one Redis shard.\n\u26a0 Cache stampede on cold start: all instances hit DB simultaneously.\n\u26a0 Single API instance still a bottleneck \u2192 need LB + replicas.\n\u26a0 No async write path \u2192 analytics blocks the redirect.",
      "lineHeight": 1.25
    },
