      "seed": 1578301,
      "version": 1,
      "versionNonce": 893860,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 13,
      "fontFamily": 1,
      "text": "ActiveState.pay() sequence:\n  1. fee = t.lot().pricing().computeFee(t)   \u2190 uses lot's PricingStrategy\n  2. method.charge(fee)                      \u2190 uses caller's PaymentMethodStrategy\n  3. t.transitionTo(new PaidState(ref))      \u2190 uses State transition",
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 11,
      "containerId": "b0e6923c1a804c87",
      "originalText": "ActiveState.pay() sequence:\n  1. fee = t.lot().pricing().computeFee(t)   \u2190 uses lot's PricingStrategy\n  2. method.charge(fee)                      \u2190 uses caller's PaymentMethodStrategy\n  3. t.transitionTo(new PaidState(ref))      \u2190 uses State transition",
      "lineHeight": 1.25
    },
    {
      "id": "e8560edb5110fb8c",
