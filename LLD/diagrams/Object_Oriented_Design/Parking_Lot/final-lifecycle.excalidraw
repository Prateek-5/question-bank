      "locked": false,
      "fontSize": 15,
      "fontFamily": 1,
      "text": "ActiveState.pay() is the meeting point of THREE strategies (pricing from lot, payment from caller, state from ticket).",
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "ActiveState.pay() is the meeting point of THREE strategies (pricing from lot, payment from caller, state from ticket).",
      "lineHeight": 1.25
    },
