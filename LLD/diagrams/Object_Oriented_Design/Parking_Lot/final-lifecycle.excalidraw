      "fontSize": 16,
      "fontFamily": 1,
      "text": "Ticket\n\nstate : TicketState* \u25c6\n\n+ pay(m)   \u2192 state.pay()\n+ exit()   \u2192 state.exit()\n+ transitionTo(s)",
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 14,
      "containerId": "fe0eb4d7a18c1967",
      "originalText": "Ticket\n\nstate : TicketState* \u25c6\n\n+ pay(m)   \u2192 state.pay()\n+ exit()   \u2192 state.exit()\n+ transitionTo(s)",
      "lineHeight": 1.25
    },
