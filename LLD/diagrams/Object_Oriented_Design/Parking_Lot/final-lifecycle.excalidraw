      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 13,
      "fontFamily": 1,
      "text": "PaymentMethodStrategy is NOT a field on Ticket or Lot.\nIt's PASSED into pay() by the caller (e.g., the ExitGate).\nDifferent actor owns each strategy.",
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 11,
      "containerId": "e8560edb5110fb8c",
      "originalText": "PaymentMethodStrategy is NOT a field on Ticket or Lot.\nIt's PASSED into pay() by the caller (e.g., the ExitGate).\nDifferent actor owns each strategy.",
      "lineHeight": 1.25
    }
