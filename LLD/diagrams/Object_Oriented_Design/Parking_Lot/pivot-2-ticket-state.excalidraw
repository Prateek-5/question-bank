      "fontSize": 15,
      "fontFamily": 1,
      "text": "The status enum + if/else branching becomes a class hierarchy. Calling pay() on a PaidState throws \u2014 polymorphism IS the validation.",
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "The status enum + if/else branching becomes a class hierarchy. Calling pay() on a PaidState throws \u2014 polymorphism IS the validation.",
      "lineHeight": 1.25
    },
