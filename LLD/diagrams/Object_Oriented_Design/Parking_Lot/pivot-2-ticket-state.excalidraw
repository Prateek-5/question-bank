      "fontSize": 16,
      "fontFamily": 1,
      "text": "Ticket\n\nstatus : enum\n  ACTIVE | PAID | EXITED\n\n+ pay(m) { if/else }\n+ exit() { if/else }",
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 14,
      "containerId": "60d699c47ccb769f",
      "originalText": "Ticket\n\nstatus : enum\n  ACTIVE | PAID | EXITED\n\n+ pay(m) { if/else }\n+ exit() { if/else }",
      "lineHeight": 1.25
    },
