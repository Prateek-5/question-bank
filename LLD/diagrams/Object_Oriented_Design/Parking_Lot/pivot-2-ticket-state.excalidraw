      "fontSize": 16,
      "fontFamily": 1,
      "text": "Ticket\n\nstate : TicketState*\n  (unique_ptr \u2014 owns)\n\n+ pay(m) \u2192 state.pay()\n+ exit() \u2192 state.exit()\n+ transitionTo(s)",
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 14,
      "containerId": "165380d174ed3912",
      "originalText": "Ticket\n\nstate : TicketState*\n  (unique_ptr \u2014 owns)\n\n+ pay(m) \u2192 state.pay()\n+ exit() \u2192 state.exit()\n+ transitionTo(s)",
      "lineHeight": 1.25
    },
